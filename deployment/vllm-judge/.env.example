# ─────────────────────────────────────────────────────────────
# vLLM Judge Service — Apptainer Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy to .env and source before running operator scripts:
#   cp .env.example .env
#   source .env
#
# NOTE: Model weights path is HARDWIRED to /share/goyal/md2292/huggingface
# (site policy). Do not change HF_HOME here; it is set in operator scripts.
# ─────────────────────────────────────────────────────────────

# ── Apptainer ───────────────────────────────────────────────
# Module name for `module load` (site-specific)
APPTAINER_MODULE=apptainer-1.4.5

# OCI image URI for `apptainer pull`
# Blackwell (B200/GB200) requires cu130 build.
# After first successful pull, pin to a digest:
#   VLLM_IMAGE=docker://vllm/vllm-openai@sha256:<digest>
VLLM_IMAGE=docker://vllm/vllm-openai:cu130-nightly

# ── Model ───────────────────────────────────────────────────
# HuggingFace model ID (pre-quantized FP8; no --quantization flag needed)
MODEL=Qwen/Qwen3.5-122B-A10B-FP8

# Name exposed via /v1/models endpoint
SERVED_MODEL_NAME=Qwen3.5-122B-A10B-FP8

# ── Hardware ────────────────────────────────────────────────
# Tensor parallel size — must match allocated GPU count
TP_SIZE=2

# Fraction of GPU memory vLLM may use (0.0-1.0)
GPU_MEMORY_UTILIZATION=0.92

# ── Context / tokens ───────────────────────────────────────
# Maximum sequence length (prompt + generation).
# 65536 covers >99% of judge inputs. Reduce if OOM.
MAX_MODEL_LEN=65536

# ── Reasoning parser ───────────────────────────────────────
# Required for Qwen3.5 thinking models
REASONING_PARSER=qwen3

# ── Networking ──────────────────────────────────────────────
# Bind address for vLLM inside the container
VLLM_HOST=0.0.0.0
VLLM_PORT=8000

# ── Hugging Face ────────────────────────────────────────────
# Required if model repo is gated.
# Generate at https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Stability ──────────────────────────────────────────────
# Flash Attention version — FA3 on Blackwell may be unstable; FA2 is safer.
VLLM_FLASH_ATTN_VERSION=2

# Allow vLLM to use context lengths beyond default limits
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1

# ── Extra vLLM args ────────────────────────────────────────
# Append additional vllm serve arguments (space-separated).
# Examples:
#   --language-model-only          (skip vision encoder if applicable)
#   --enable-chunked-prefill       (useful for prefill-heavy batches)
#   --max-num-batched-tokens 8192  (tune batch size)
EXTRA_VLLM_ARGS=
